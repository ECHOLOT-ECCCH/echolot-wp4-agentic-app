# Build context of deploy/Dockerfile: only what the images need. An allowlist, so secrets
# (deploy/.env, deploy/config/) and local data never reach the build.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/web
!pyproject.toml
!uv.lock
!.python-version
!apps/server
!runner
!services
!deploy/Caddyfile

# never, even inside the directories above
**/node_modules
**/__pycache__
**/.pytest_cache
apps/web/dist
apps/web/test-results
apps/web/playwright-report
apps/web/e2e
apps/server/tests
runner/runner_tests
runner/services.toml
runner/runner.env
