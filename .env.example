# Copy to .env for local development. All app settings use the ECHO_ prefix (docs/PLAN.md).

# SQLite database (app.db) and uploaded files
ECHO_DATA_DIR=./data

# Accounts: there is no sign-up. Create the first admin from the shell, then add users under
# Settings → Users (or with the same command):
#   uv run echolot-admin create-user you@example.org --name "You" --admin
# Users' own model keys are encrypted with ECHO_SECRET_KEY (Fernet keys, comma-separated, the
# first encrypts). Unset, a key is generated once into $ECHO_DATA_DIR/secret.key; set it in
# production and keep it out of backups of the data directory.
# ECHO_SECRET_KEY=
# Days a session lasts without use; the cookie is Secure when ECHO_PUBLIC_URL is https
# ECHO_SESSION_DAYS=14
# ECHO_COOKIE_SECURE=

# The server's own model, offered to every user as "Server default" (users can also bring their
# own keys under Settings → Model keys). Providers: anthropic, openai, google, mistral,
# openrouter, deepseek, openai_compatible (set ECHO_MODEL_BASE_URL), and test (canned answers,
# needs ECHO_ENABLE_TEST_MODEL=1, no key). Without a key there is no server default.
ECHO_MODEL_PROVIDER=test
ECHO_MODEL_ID=test
# ECHO_MODEL_PROVIDER=anthropic
# ECHO_MODEL_ID=claude-sonnet-5-5
# ECHO_MODEL_API_KEY=sk-ant-...
ECHO_ENABLE_TEST_MODEL=1
# Let users add their own OpenAI-compatible endpoint (the server then calls URLs they enter)
# ECHO_ALLOW_CUSTOM_ENDPOINTS=0

# The agent-facing service docs (services/<name>.md)
ECHO_SERVICES_DIR=./services

# Where runs execute: local (a subprocess on this machine) or prefect (docs/PLAN.md 7.6)
ECHO_EXECUTOR=local
# local: the services the runner subprocess may call (see runner/services.example.toml), and a
# file with their keys (KEY=VALUE lines, e.g. ECHOLOT_API_KEY=...), added to the runner's
# environment. Keys do not belong in this .env: it is read into the app's settings only.
ECHO_LOCAL_SERVICES_FILE=./services.toml
ECHO_LOCAL_RUNNER_ENV_FILE=./runner.env
# The URL the runner uses to reach this app's /runner endpoints
ECHO_PUBLIC_URL=http://127.0.0.1:8000
# ECHO_PREFECT_API_URL=http://127.0.0.1:4200/api
# ECHO_PREFECT_AUTH_STRING=admin:pass
# ECHO_PREFECT_DEPLOYMENT=run-script/default

ECHO_LOG_LEVEL=INFO
