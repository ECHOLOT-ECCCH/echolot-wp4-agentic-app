# deploy/.env: read by docker compose (this directory) and passed to the app container.
# ./init.sh copies this file to .env and fills in the secret key. Never commit .env.

# --- the site ------------------------------------------------------------------------------------
# A domain pointing at this host gets an automatic Let's Encrypt certificate (ports 80 and 443
# open). Behind a reverse proxy that terminates TLS, or for a trial on localhost: ":80".
SITE_ADDRESS=workbench.example.org
# Host ports of the web container (behind a proxy, e.g. HTTP_PORT=127.0.0.1:8080)
HTTP_PORT=80
HTTPS_PORT=443
# The address of a reverse proxy in front, trusted for the client address (sign-in throttling)
# TRUSTED_PROXY_CIDR=192.0.2.10/32
# Largest upload (Caddy size, e.g. 500MB, 2GB)
MAX_UPLOAD_SIZE=1GB

# --- the secret key (./init.sh generates it) -----------------------------------------------------
# Encrypts the users' model keys (Fernet key; "new,old" to rotate). Losing it loses those keys.
ECHO_SECRET_KEY=

# --- sessions --------------------------------------------------------------------------------------
# Secure cookies need https in the browser. Only for a plain-http trial on another machine than
# localhost: false
ECHO_COOKIE_SECURE=true
# ECHO_SESSION_DAYS=14

# --- models --------------------------------------------------------------------------------------
# Users bring their own keys (Settings → Model keys). With a key here, this model is also offered
# to everyone as "Server default", on your bill. Providers: anthropic, openai, google, mistral,
# openrouter, deepseek, openai_compatible (with ECHO_MODEL_BASE_URL).
ECHO_MODEL_PROVIDER=anthropic
ECHO_MODEL_ID=claude-sonnet-5-5
# ECHO_MODEL_API_KEY=
# ECHO_MODEL_BASE_URL=
# Let users add their own OpenAI-compatible endpoint (the server then calls URLs they enter)
# ECHO_ALLOW_CUSTOM_ENDPOINTS=false

# --- runs ----------------------------------------------------------------------------------------
# The Prefect server the app sends runs to: its API (usually ending in /api) and how to sign in,
# either basic auth (user:password, the server's PREFECT_SERVER_API_AUTH_STRING) or an API key
# (Prefect Cloud, or a proxy that wants a bearer token). Check it with
# "docker compose exec app echolot-admin check-runs".
ECHO_PREFECT_API_URL=https://prefect.example.org/api
ECHO_PREFECT_AUTH_STRING=
# ECHO_PREFECT_API_KEY=
# Where the runner fetches each run's input and sends its results: this site's own address
ECHO_PUBLIC_URL=https://workbench.example.org

# Where the runner runs (deploy/README.md, "Runs"):
# - next to ECHOLOT, on a host of its own (docs/runner-host.md): nothing more to set here
# - in this stack: the next line, ECHO_PUBLIC_URL=http://app:8000, and the services and their
#   keys in config/services.toml and config/runner.env
# COMPOSE_PROFILES=runner
# - in this stack with a Prefect server of its own too: ./init.sh --with-prefect writes that
# - scripts inside the app container, no Prefect (trusted users only; see that file):
# COMPOSE_FILE=docker-compose.yml:docker-compose.local-runs.yml
# The Prefect version of the runner image, to match the server's (default: uv.lock's, 3.8.8);
# also the bundled server's
# PREFECT_VERSION=3.8.8
# Runs a runner of this stack executes at the same time
# RUNNER_MAX_RUNS=4

# --- images --------------------------------------------------------------------------------------
# Built here by "docker compose up --build"; set these to use images from a registry instead.
# IMAGE_PREFIX=ghcr.io/echolot-eccch/echolot-workbench-
# IMAGE_TAG=main

# ECHO_LOG_LEVEL=INFO

# Where the files live, when not here (absolute paths, e.g. under /etc/echolot)
# APP_ENV_FILE=.env
# RUNNER_ENV_FILE=config/runner.env
# SERVICES_FILE=./config/services.toml
