# SITE_ADDRESS: ":80" for plain http on localhost or behind an institutional reverse proxy that
# terminates TLS, or a domain such as "dictionaries.example.org" for automatic HTTPS. Set it in .env.
{
	# Behind a reverse proxy, Caddy must trust that proxy for the X-Forwarded-Proto/Host/For it
	# sends to reach Keycloak and the API (otherwise Keycloak sees plain http and answers "HTTPS
	# required"). Private ranges are trusted always; TRUSTED_PROXY_CIDR in .env adds the proxy's
	# address, e.g. 194.249.231.96/32.
	servers {
		trusted_proxies static private_ranges {$TRUSTED_PROXY_CIDR:127.0.0.1/32}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Keycloak lives under /idp (KC_HTTP_RELATIVE_PATH), so the site needs one hostname and
	# one certificate; its admin console is /idp/admin/.
	handle /idp/* {
		reverse_proxy keycloak:8080
	}

	@backend path /api/* /auth/* /healthz
	handle @backend {
		reverse_proxy api:8000 {
			# stream chat and server-sent events without buffering
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 2GB
	}

	log {
		output stdout
		format console
	}
}
