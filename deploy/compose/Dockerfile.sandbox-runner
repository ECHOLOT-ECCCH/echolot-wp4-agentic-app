# Sandbox runner service (the only container that talks to the Docker daemon in milestone 3).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY packages/sandbox/pyproject.toml ./
COPY packages/sandbox/src ./src
RUN uv pip install --system --no-cache .
EXPOSE 8010
HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD curl -fsS http://localhost:8010/healthz || exit 1
CMD ["uvicorn", "elexifier_sandbox.runner.main:app", "--host", "0.0.0.0", "--port", "8010"]
