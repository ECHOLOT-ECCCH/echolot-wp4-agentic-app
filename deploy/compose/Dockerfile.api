# API and worker image. Build context is the repository root.
FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home app
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN uv sync --frozen --no-dev --no-editable && chown -R app:app /app
COPY deploy/compose/entrypoint-api.sh /usr/local/bin/entrypoint-api
RUN chmod +x /usr/local/bin/entrypoint-api
ENV PATH="/app/.venv/bin:$PATH"
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD curl -fsS http://localhost:8000/healthz || exit 1
ENTRYPOINT ["entrypoint-api"]
CMD ["uvicorn", "elexifier_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
