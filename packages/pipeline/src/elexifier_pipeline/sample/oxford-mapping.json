{
  "inSelector": "/oxford",
  "outElement": "lexicographicResource",
  "textVals": [
    {"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}constant", "constant": "Oxford English-Slovene sample", "outElement": "title"},
    {"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}constant", "constant": "http://example.org/oxford-sample", "outElement": "uri"},
    {"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}constant", "constant": "en", "outElement": "langCode"}
  ],
  "children": [
    {
      "inSelector": "se",
      "outElement": "entry",
      "jsonPlural": "entries",
      "textVals": [
        {"inSelector": "hw", "attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}innerTextRec", "outElement": "headword"},
        {"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}autogenerated", "outElement": "id"}
      ],
      "children": [
        {
          "inSelector": "hg/ps",
          "outElement": "partOfSpeech",
          "jsonPlural": "partsOfSpeech",
          "textVals": [
            {"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}innerText", "outElement": "tag",
             "xlat": {"sam.": "noun", "glag.": "verb", "prid.": "adjective", "prisl.": "adverb", "predl.": "preposition", "vez.": "conjunction", "zaim.": "pronoun", "medm.": "interjection", "štev.": "numeral", "čl.": "article"}}
          ]
        },
        {
          "inSelector": "hg/pr/ph[normalize-space()]",
          "outElement": "pronunciation",
          "children": [
            {"inSelector": ".", "outElement": "transcription",
             "textVals": [{"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}innerText", "outElement": "text"},
                          {"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}constant", "constant": "ipa", "outElement": "scheme"}]}
          ]
        },
        {
          "inSelector": "s2 | s1 | self::se[not(s1) and not(s2)]",
          "outElement": "sense",
          "textVals": [{"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}autogenerated", "outElement": "id"}],
          "children": [
            {
              "inSelector": "tr",
              "outElement": "definition",
              "textVals": [{"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}innerTextRec", "outElement": "text", "excludeSelector": "ann | la", "normalizeWhitespace": true}]
            },
            {
              "inSelector": "tr/ann/la | tr/la",
              "outElement": "label",
              "textVals": [{"attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}innerText", "outElement": "tag"}]
            },
            {
              "inSelector": "e",
              "outElement": "example",
              "textVals": [{"inSelector": "le | ls | lc", "attribute": "{http://elex.is/wp1/teiLex0Mapper/meta}innerTextRec", "outElement": "text"}]
            }
          ]
        }
      ]
    }
  ]
}
